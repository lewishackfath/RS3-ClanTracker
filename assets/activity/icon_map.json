{
  "Fealty3": {
    "icon": "assets/activity/fealty_3.png",
    "activity_text": "Maintained Clan Fealty 3"
  },
  "ReachedFealty3": {
    "icon": "assets/activity/fealty_3.png",
    "activity_text": "Reached Clan Fealty 3"
  },
  "ReachedFealty2": {
    "icon": "assets/activity/fealty_2.png",
    "activity_text": "Reached Clan Fealty 2"
  },
  "ReachedFealty1": {
    "icon": "assets/activity/fealty_1.png",
    "activity_text": "Reached Clan Fealty 1"
  },
  "comp": {
    "icon": "assets/activity/CompCape.png",
    "activity_text": "Bought my first completionist cape"
  },
  "Mystery": {
    "icon": "assets/activity/arch_mystery.png",
    "activity_text": "Solved an archaeological mystery."
  },
  "Citadel": {
    "icon": "assets/activity/citadel.png",
    "activity_regex": "^(Capped|Visited) (at )?my Clan Citadel\\.$",
    "regex_flags": "i"
  },
  "CaseWon": {
    "icon": "assets/activity/case.png",
    "activity_regex": "^Won a case involving .+\\.$",
    "regex_flags": "i"
  },
  "CaseSummoned": {
    "icon": "assets/activity/case.png",
    "activity_regex": "^Summoned for a case involving .+\\.$",
    "regex_flags": "i"
  },
  "DungeonFloorReached": {
    "icon": "assets/skills/dungeoneering.png",
    "activity_regex": "^Dungeon floor\\s+\\d+\\s+reached\\.\\s*$",
    "regex_flags": "i"
  },
  "DaemonheimHistory": {
    "icon": "assets/skills/dungeoneering.png",
    "activity_regex": "^Daemonheim's history uncovered,\\s+\\d+\\s+volumes found\\.\\s*$",
    "regex_flags": "i"
  },
  "MusicUnlocked": {
    "icon": "assets/activity/Music_icon.webp",
    "activity_regex": "^(?:\\d{1,3}(?:,\\d{3})+|\\d+)\\s+songs unlocked\\.?\\s*$",
    "regex_flags": "i"
  },
  "Tetracompass": {
    "icon": "assets/activity/Tetracompass.webp",
    "activity_text": "Completed a tetracompass",
  },
  "FightKiln": {
    "icon": "assets/activity/FightKiln.webp",
    "activity_text": "Completed the Fight Kiln",
  },
  "TreasureTrail": {
    "icon": "assets/activity/Clue_Scrolls.webp",
    "activity_regex": "^.+?\\s+treasure trail completed\\.?\\s*$",
    "regex_flags": "i"
  },
  "TotalLevelGained": {
    "icon": "assets/activity/TotalLevelMilestone.png",
    "activity_regex": "^(?:\\d{1,3}(?:,\\d{3})+|\\d+)\\s+Total levels gained\\.?\\s*$",
    "regex_flags": "i"
  },
  "ChampionScroll": {
    "icon": "assets/activity/ChampionScroll.png",
    "activity_regex": "^A message was dropped by an?\\s+.+?\\s+from the\\s+.+?\\s+Champion, challenging me to a fight\\.?\\s*$",
    "regex_flags": "i"
  },
  "ChampionChallenge": {
    "icon": "assets/activity/ChampionChallenge.png",
    "activity_regex": "^Won a challenge against the\\s+.+?\\s+Champion\\.?\\s*$",
    "regex_flags": "i"
  }
}